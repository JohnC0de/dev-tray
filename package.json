{
  "name": "dev-tray",
  "version": "0.1.0",
  "description": "localhost, organized. A tiny tray app that tracks your dev servers across projects.",
  "license": "MIT",
  "private": true,
  "main": "apps/desktop/out/main/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/desktop run dev",
    "build": "npm --prefix apps/desktop run build",
    "dist": "npm --prefix apps/desktop run dist",
    "pack": "npm --prefix apps/desktop run pack",
    "build:native": "npm --prefix packages/scan-native run build",
    "test": "npm --prefix packages/core run test && npm --prefix apps/desktop run test",
    "test:native": "npm --prefix packages/scan-native run test",
    "scan:once": "npm --prefix apps/desktop run scan:once",
    "start": "npm run dev",
    "gen:icons": "node scripts/gen-icons.js"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}
